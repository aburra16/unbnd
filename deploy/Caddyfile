# Reverse proxy + static host (ADR 0007). SITE_ADDRESS drives automatic
# HTTPS; defaults to localhost for local smoke tests (Caddy uses an internal
# cert there). On the droplet, SITE_ADDRESS=staging.unbnd.ink.
{$SITE_ADDRESS:localhost} {
	encode gzip

	# API surface -> the api container.
	handle /auth/* {
		reverse_proxy api:8787
	}
	handle /api/* {
		reverse_proxy api:8787
	}
	handle /health* {
		reverse_proxy api:8787
	}

	# NIP-05 (librarian identity). The spec requires permissive CORS on
	# nostr.json so any nostr client can resolve the identifier. Routed
	# explicitly so the SPA catch-all below doesn't shadow it.
	handle /.well-known/nostr.json {
		header Access-Control-Allow-Origin "*"
		root * /srv
		file_server
	}

	# Link unfurls (Story 72 / ADR 0070). A recognized social crawler hitting a
	# book URL is reverse-proxied to the API's unfurl service, which returns a
	# per-book Open Graph / Twitter card document (those crawlers do not run JS,
	# so the SPA's client-rendered tags are invisible to them). Every non-crawler
	# request falls through to the static SPA below, so the human read path is
	# untouched. An unrecognized crawler simply gets the SPA's generic card
	# (graceful degrade). The oEmbed JSON endpoint rides the /api/* proxy above.
	handle /book/* {
		@crawler header_regexp User-Agent (?i)(facebookexternalhit|twitterbot|slackbot|discordbot|whatsapp|telegrambot|linkedinbot|redditbot|pinterest|embedly|googlebot|bingbot|bot|crawl|spider|preview|unfurl|embed)
		handle @crawler {
			rewrite * /unfurl{uri}
			reverse_proxy api:8787
		}
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}

	# Everything else is the SPA.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Apex / production domain. Reserved for a deliberate production release; the
# staging.unbnd.ink site above is the only auto-deployed environment. Until that
# release the apex serves ONLY the librarian NIP-05 (so librarian@unbnd.ink
# resolves); every other path 404s. Env-gated: APEX_ADDRESS is unset locally, so
# this defaults to *.localhost (Caddy internal cert, no public ACME). Set
# APEX_ADDRESS=unbnd.ink in the droplet .env to activate. This block does not run
# the app and does not touch SITE_ADDRESS or the data layer's DOMAIN_NAME.
{$APEX_ADDRESS:apex.localhost} {
	encode gzip

	handle /.well-known/nostr.json {
		header Access-Control-Allow-Origin "*"
		root * /srv
		file_server
	}

	handle {
		respond 404
	}
}
