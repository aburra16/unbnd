# Staging production env (ADR 0007). Copy to /opt/unbnd/.env on the droplet
# and fill in real values. NEVER commit the filled-in .env.
# Values are generated by the operator tooling and set via `gh secret set`
# + written here; the librarian nsec is held off-server.

# Public hostname Caddy serves + provisions TLS for (the staging app).
SITE_ADDRESS=staging.unbnd.ink
# What the API advertises as its public origin (cookie scoping, relay hints).
PUBLIC_ORIGIN=https://staging.unbnd.ink
# Apex/production domain. Served ONLY for the librarian NIP-05 (every other path
# 404s); reserved for a deliberate production release. Requires DNS A record
# unbnd.ink -> droplet. Leave unset to keep the apex inert.
APEX_ADDRESS=unbnd.ink

# Postgres (accounts + sessions).
POSTGRES_PASSWORD=

# Neo4j (data layer).
NEO4J_PASSWORD=

# Meilisearch master key (>= 16 bytes).
SEARCH_API_KEY=

# 32-byte hex backup key for custodial nsec recovery (PRD §8.4).
BACKUP_ENCRYPTION_KEY=

# Hex pubkey of the librarian/house identity that owns the kind-39998 concept
# headers. The matching nsec is held off-server (never here). Also consumed by
# the data-layer image as OWNER_PUBKEY.
LIBRARIAN_PUBKEY=

# --- Catalog seeder (ADR 0008), only used by the `seed` compose profile ---
# Relay the DLists are published to (the local strfry syncs down from it).
DCOSL_RELAY_URL=wss://dcosl.brainstorm.world/
# Librarian nsec for SIGNING the seeded catalog events. Only the seeder needs
# it; the app never does. This is the adopted production librarian identity
# (not a throwaway); the matching npub is the house observer. Keep this file
# 0600 and hold an offline backup of the nsec.
LIBRARIAN_NSEC=
# Works fetched per Open Library subject (8 subjects). 300 -> ~1-2k books.
PER_SUBJECT=300
