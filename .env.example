# Tapestry container — relay-level admin key. Generate with:
#   node scripts/generate-keypair.js
# Paste the hex pubkey here. The nsec is yours; do not commit it.
OWNER_PUBKEY=

# Neo4j password — choose any strong value for dev. Production uses a secret manager.
NEO4J_PASSWORD=tapestry-local-dev

# Data-layer URLs as seen from apps/api running on the host.
STRFRY_URL=ws://localhost:7777
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_USER=neo4j
TAPESTRY_API_URL=http://localhost:8080
# Search: Brainstorm's search relay (ADR 0100).
SEARCH_URL=wss://search.brainstorm.world

# Postgres (accounts + sessions). POSTGRES_PASSWORD is consumed by the db
# container; DATABASE_URL is what apps/api connects with.
POSTGRES_PASSWORD=unbnd-local-dev
DATABASE_URL=postgres://unbnd:unbnd-local-dev@localhost:5432/unbnd

# Server-managed backup key for custodial nsec recovery (PRD §8.4).
# 32 bytes, hex-encoded. Generate with:
#   node scripts/generate-backup-key.js
BACKUP_ENCRYPTION_KEY=

# Public origin of the web app. Used for NIP-42 challenge relay hints and
# cookie scoping. Defaults to the Vite dev server; set to https://unbnd.ink
# in production.
PUBLIC_ORIGIN=http://localhost:5181

# Hex pubkey of the librarian/house identity that owns the kind-39998 concept
# headers. Required for rating publish/read-back and for search (whose index
# covers this librarian's books list); when unset, both report themselves
# unavailable. 64 lowercase hex chars.
LIBRARIAN_PUBKEY=

# Shared relay (dcosl) that community writes (ratings, tag assertions) are
# propagated TO so they become globally visible and durable beyond the local
# relay (ADR 0011). When set, the API dual-publishes accepted writes here
# best-effort; the `unbnd-upsync` cron is the durability backstop. Leave unset
# in dev/test so local writes never reach production dcosl. ws:// or wss://.
DCOSL_RELAY_URL=
# Set to "false" to disable dual-publish even when DCOSL_RELAY_URL is set.
PROPAGATE_WRITES=true

# Public relays queried (best-effort) for a user's kind-0 profile metadata
# (name/picture) — sovereign identity lives on the broad network, not dcosl
# (ADR 0012). Comma-separated; leave blank to use the built-in default set
# (damus / primal / nos.lol / nostr.band, plus dcosl).
PROFILE_RELAYS=

# Trust-weighting (ADR 0014). Brainstorm API base + the nip85 relays that hold
# the trust-score events, and the default "house" observer pubkey (hex) whose
# Web of Trust powers the default view. Blank HOUSE_OBSERVER_PUBKEY disables the
# house-weighted default (falls back to raw counts). Defaults: nosfabrica.
# Leave BRAINSTORM_API_URL and TRUST_RELAYS blank to use Brainstorm production,
# kept in one place: BRAINSTORM_DEFAULTS in packages/trust (ADR 0088).
BRAINSTORM_API_URL=
TRUST_RELAYS=
HOUSE_OBSERVER_PUBKEY=be7bf5de068c1d842ed34a7c270507ec940f5ea51671cfd062a95e9d09420d0a

# Book reviews (Story 99 / ADR 0089): how often the API pulls reviews written in
# other apps from the review relays and re-sends Unbnd's recent ones to the
# Brainstorm index. Milliseconds; blank = 2 minutes; 0 turns the sync off.
REVIEW_SYNC_INTERVAL_MS=
